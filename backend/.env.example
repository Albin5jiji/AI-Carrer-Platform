# Copy to .env and adjust for your machine.
DATABASE_URL=postgresql+psycopg://career_user:career_pass@localhost:5432/career_platform
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173","http://localhost:4173"]
# Development convenience: create missing tables and reference data on startup.
# Set both to false once you manage the schema with Alembic migrations.
AUTO_CREATE_TABLES=true
SEED_REFERENCE_DATA=true

# Optional AI advisory analysis. Leave disabled unless you add an API key.
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_API_KEY=replace-with-your-api-key
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Optional private S3-compatible resume storage. File upload remains unavailable until configured.
RESUME_STORAGE_BUCKET=ai-career-platform-resumes-albin-2026
RESUME_STORAGE_REGION=eu-north-1
RESUME_STORAGE_ENDPOINT=
RESUME_STORAGE_PREFIX=resumes
RESUME_PRESIGN_EXPIRY_SECONDS=900
RESUME_MAX_FILE_SIZE_BYTES=5242880
# Create an IAM access key with access limited to this bucket; never commit it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
